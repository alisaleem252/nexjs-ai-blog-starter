# --- RapidTextAI (https://app.rapidtextai.com -> dashboard -> API key) ---
RAPIDTEXTAI_API_KEY=your-api-key-here

# --- Your WordPress site (the content store) ---
WP_URL=https://your-wordpress-site.com
# Create an Application Password: WP Admin -> Users -> Profile -> Application Passwords
WP_USER=your-wp-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- Public site ---
NEXT_PUBLIC_SITE_NAME=My AI Blog
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: lets you call POST /api/generate (send it as the x-generate-secret header) ---
GENERATE_SECRET=change-me-to-a-long-random-string
